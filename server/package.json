    "@fastify/static": "^8.0.2",
    "@prisma/client": "^6.2.1",
    "@questionbible/shared": "*",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
